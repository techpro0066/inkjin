APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Public Bookpay origin used by JS on pages reverse-proxied from inkjin.com/@username
# BOOKPAY_PUBLIC_URL=https://bookpay.inkjin.com
# Comma-separated origins allowed to call /api/public/* with credentials
# CORS_ALLOWED_ORIGINS=https://inkjin.com,https://www.inkjin.com
# Required in production so session/CSRF cookies work across inkjin.com ↔ bookpay.inkjin.com
# SESSION_DOMAIN=.inkjin.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=inkjin
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Admin notifications (Stripe balance alerts, etc.). Falls back to first admin user email if unset.
ADMIN_EMAIL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_CONNECT_DEFAULT_COUNTRY=GR
STRIPE_CONNECT_LOCALE=en-US
STRIPE_CONNECT_FORCE_INDIVIDUAL=true
STRIPE_CONNECT_EXCLUDE_BUSINESS_DETAILS=true
STRIPE_CONNECT_EXCLUDE_BANK_COUNTRY=true
# Public site URL for artist profile links sent to Stripe (use when APP_URL is localhost).
# STRIPE_CONNECT_BUSINESS_URL_BASE=https://yourdomain.com
# STRIPE_CONNECT_INDIVIDUAL_BUSINESS_WEBSITE_URL=https://www.inkjin.com
STRIPE_CONNECT_COUNTRIES_CACHE_TTL=86400
STRIPE_CONNECT_DISABLE_USER_AUTHENTICATION=true

# Viva Wallet (IRIS QR payments)
VIVA_CLIENT_ID=
VIVA_CLIENT_SECRET=
VIVA_MERCHANT_ID=
VIVA_API_KEY=
VIVA_SOURCE_CODE=2461
VIVA_WEBHOOK_KEY=
VIVA_ENV=production
VIVA_ACCOUNTS_BASE=https://accounts.vivapayments.com
VIVA_API_BASE=https://api.vivapayments.com
VIVA_CHECKOUT_BASE=https://www.vivapayments.com
VIVA_ORDER_TIMEOUT_SECONDS=300

STREAM_API_KEY=
STREAM_API_SECRET=
STREAM_TOKEN_TTL=86400

# Anthropic Claude (Available Designs AI field suggestions)
Claude_API_KEY=
# Optional overrides:
# Claude_MODEL=claude-sonnet-5
# Claude_TIMEOUT=60

# Instagram (Meta App ? Instagram ? API setup with Instagram login)
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI="/auth/instagram/callback"
INSTAGRAM_SCOPES=instagram_business_basic

